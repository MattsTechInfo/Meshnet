#!/bin/bash

# Set permissions to executable
chmod a+x /usr/bin/nordvpn_login
chmod a+x /usr/bin/meshnet_config
chmod a+x /usr/bin/meshnet_watch
chmod a+x /etc/services.d/nordvpn/data/check
chmod a+x /etc/services.d/nordvpn/run
chmod a+x /etc/services.d/nordvpn/finish
echo "Executable permissions set."